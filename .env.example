# Copy to .env. Never commit real values.
POSTGRES_PASSWORD=change-me
ZF_MASTER_KEY=            # openssl rand -base64 32  (wraps every stored secret)
ZF_SESSION_SECRET=        # optional; derived from the master key when empty
ZF_PUBLIC_URL=http://localhost:8787
ZF_DEV_LOGIN=0            # 1 only for local trials; production uses OIDC
ZF_ALLOW_PUBLIC_DEV_LOGIN=0 # 1 lets dev login start on a non-local ZF_PUBLIC_URL (a tunnel): anyone who can reach it can sign in as ANYONE
PG_DATA_DIR=              # e.g. /data/postgres to keep the database on a separate disk
CURSOR_API_KEY=           # only for trials without the UI connection; normally add a Cursor connection in the app
OIDC_ISSUER=              # e.g. https://login.microsoftonline.com/<tenant>/v2.0 (Entra ID)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ADMIN_GROUPS=        # comma separated group ids or names
OIDC_APPROVER_GROUPS=
OIDC_ALLOWED_DOMAINS=       # comma separated email domains that may sign in, e.g. acme.com (strongly recommended with Entra ID)
OIDC_BOOTSTRAP_ADMIN=       # only this email may become the first (admin) user
S3_ACCESS_KEY=zerovity
S3_SECRET_KEY=change-me-too
ZF_HOST_DATA_DIR=/var/lib/zerovity
ZF_ADVISOR_API_KEY=       # optional: lets the foreman advisor use a small Claude model; rules are used when empty
ZF_FORCE_HARNESS=         # fake = offline demo harness for every agent