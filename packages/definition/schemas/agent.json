{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "INTENT",
        "SPEC",
        "BUILD",
        "VERIFY",
        "SHIP",
        "CUSTOM"
      ]
    },
    "role": {
      "type": "string"
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextScopes": {
      "default": [
        "org",
        "factory",
        "repo",
        "workItem"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "org",
          "factory",
          "repo",
          "workItem",
          "phase"
        ]
      }
    },
    "harness": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "copilot",
            "cursor",
            "fake"
          ]
        },
        "model": {
          "type": "string"
        },
        "reasoning": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "outputs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spawnableBy": {
      "default": [
        "foreman"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mcpServers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "credential": {
      "type": "string"
    },
    "runner": {
      "type": "string"
    },
    "secrets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maxRunMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "contextTokenBudget": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "description",
    "phase"
  ],
  "additionalProperties": false,
  "$id": "https://zerovity.dev/schemas/zf/v1alpha1/agent.json",
  "title": "Zerovity agent (zf/v1alpha1)"
}
