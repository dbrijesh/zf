{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lockVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "packs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "hash"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$id": "https://zerovity.dev/schemas/zf/v1alpha1/lock.json",
  "title": "Zerovity lock (zf/v1alpha1)"
}
