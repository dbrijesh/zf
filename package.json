{
    "name":  "zerovity-factory",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Zerovity Factory - self-hostable software factory (spec v0.1)",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=22"
                },
    "workspaces":  [
                       "apps/*",
                       "packages/*",
                       "packages/harness/*",
                       "packages/forge/*"
                   ],
    "scripts":  {
                    "dev":  "node scripts/dev.mjs",
                    "build":  "npm run build -w @zerovity/web",
                    "start":  "tsx apps/api/src/main.ts",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "typecheck":  "tsc --noEmit -p tsconfig.json",
                    "lint":  "eslint .",
                    "zf":  "node apps/cli/bin/zf.mjs",
                    "seed":  "tsx apps/api/src/seed-cli.ts",
                    "e2e":  "playwright test",
                    "schemas":  "tsx packages/definition/scripts/export-schemas.ts",
                    "worker":  "tsx apps/worker/src/main.ts"
                },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@playwright/test":  "^1.64.1",
                            "@testing-library/react":  "^16.3.3",
                            "@types/diff":  "^7.0.2",
                            "@types/dockerode":  "^4.0.2",
                            "@types/node":  "^26.6.5",
                            "@types/pg":  "^8.23.1",
                            "@types/picomatch":  "^4.0.3",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.1.2",
                            "drizzle-kit":  "^0.31.11",
                            "eslint":  "^10.12.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "jsdom":  "^30.1.3",
                            "monaco-editor":  "^0.52.2",
                            "tsx":  "^4.23.15",
                            "typescript":  "^6.0.3",
                            "typescript-eslint":  "^8.71.2",
                            "vite":  "^8.3.4",
                            "vitest":  "^5.0.4"
                        }
}